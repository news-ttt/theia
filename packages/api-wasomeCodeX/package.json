{
  "private": true,
  "name": "PlcIDE",
  "version": "0.0.1",
  "description": "PlcIDE API",
  "dependencies": {
    "@theia/ai-chat": "1.64.0",
    "@theia/ai-chat-ui": "1.64.0",
    "@theia/ai-code-completion": "1.64.0",
    "@theia/ai-core": "1.64.0",
    "@theia/core": "1.64.0",
    "@theia/file-search": "1.64.0",
    "@theia/filesystem": "1.64.0",
    "@theia/monaco": "1.64.0",
    "@lumino/widgets": "2.5.0",
    "@theia/monaco-editor-core": "1.96.302",
    "@theia/output": "1.64.0",
    "@theia/ovsx-client": "1.64.0",
    "@theia/search-in-workspace": "1.64.0",
    "@theia/test": "1.64.0",
    "@theia/toolbar": "1.64.0",
    "@theia/vsx-registry": "1.64.0",
    "@theia/workspace": "1.64.0"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/api-samples-frontend-module",
      "backend": "lib/node/api-samples-backend-module"
    },
    {
      "electronMain": "lib/electron-main/update/sample-updater-main-module",
      "frontendElectron": "lib/electron-browser/updater/sample-updater-frontend-module"
    },
    {
      "frontendOnly": "lib/browser-only/api-samples-frontend-only-module"
    },
    {
      "frontendPreload": "lib/browser/api-samples-preload-module"
    },
    {
      "frontend": "lib/browser/always-trust-workspace-frontend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ],
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "lint": "theiaext lint",
    "build": "theiaext build",
    "watch": "theiaext watch",
    "clean": "theiaext clean",
    "copy:css": "copy src/browser/style lib/browser/style"
  },
  "devDependencies": {
    "@theia/ext-scripts": "1.64.0"
  }
